{
  "name": "xiaoli-ai-brain",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Local-first AI study workspace with sources, briefs and dual-host podcasts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "lint": "node scripts/check.mjs",
    "test": "node --test",
    "test:browser": "node --test e2e/workspace.mjs",
    "test:browser:site": "node --test e2e/hosted.mjs",
    "build:site": "node hosting/scripts/build.mjs",
    "test:site": "node hosting/scripts/validate.mjs",
    "format:check": "prettier --check web lib server.mjs test e2e fixtures scripts hosting package.json .github/workflows/ci.yml",
    "build": "node scripts/build.mjs",
    "check:secrets": "node scripts/secrets.mjs",
    "check": "npm run format:check && npm run lint && npm run check:secrets && npm test && npm run build"
  },
  "overrides": {
    "qs": "^6.16.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^1.29.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pdfjs-dist": "^5.5.207"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
