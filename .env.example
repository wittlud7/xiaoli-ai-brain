# Copy this file to .env and fill your keys.

# Text generation and knowledge summary
# Leave blank to prefer Gemini when configured, otherwise Anthropic.
STUDY_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# GPT TTS for podcast audio
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_HOST_A=coral
OPENAI_TTS_VOICE_HOST_B=verse
OPENAI_TTS_VOICE_FALLBACK=coral

# Alternative text provider (set STUDY_PROVIDER=anthropic to select explicitly)
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Local use: keep HOST as 127.0.0.1. Public binding requires a token.
HOST=127.0.0.1
PORT=3000
# At least 24 characters if set. Use HTTPS when exposing this server.
APP_ACCESS_TOKEN=
# Set to the exact external origin behind HTTPS, e.g. https://study.example.com
PUBLIC_ORIGIN=
